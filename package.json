{
  "name": "uploadmycut",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Classroom CAM for the Shapeoko with teacher-set limits: drawing in, .nc file out, built for Chromebook classrooms.",
  "license": "MIT",
  "scripts": {
    "dev": "npm run build && wrangler dev --ip 127.0.0.1 --port 8791 --local-upstream localhost",
    "dev:web": "vite web",
    "build": "vite build web",
    "deploy": "npm run build && wrangler deploy",
    "test": "node --test \"test/*.test.mjs\"",
    "icons": "node scripts/make-icons.mjs web/public",
    "test:browser": "node test/browser/run.mjs"
  },
  "devDependencies": {
    "axe-core": "4.10.3",
    "playwright-core": "1.55.0",
    "vite": "8.2.2",
    "wrangler": "4.142.0"
  },
  "dependencies": {
    "clipper-lib": "6.4.2",
    "opentype.js": "2.0.0"
  }
}
